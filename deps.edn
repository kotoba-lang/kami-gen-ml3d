;; kami-gen-ml3d — ADR-2607051120. JVM-only (executor/rig do real IO: files,
;; ProcessBuilder-adjacent GPU backend calls), like cloud-murakumo's own
;; `cloud_murakumo.executor` (`.clj`, not `.cljc`).
;;
;; :local/root deps (not Maven coords) — same convention as this org's actor
;; repos (CLAUDE.md "Actors" section: langgraph-clj override). tools.deps
;; pulls each dependency's own `:paths` onto our classpath, so
;; `cloud-murakumo.spec/load-spec` resolves `resources/murakumo.edn` as a
;; classpath resource transitively through the cloud-murakumo dependency —
;; see README "cloud-murakumo dependency" for why this is a live dependency,
;; not a copied EDN slice.
{:paths ["src" "resources"]
 :deps {
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.gftdcojp/cloud-murakumo {:local/root "../../network-awai/cloud-murakumo"}
        io.github.kotoba-lang/org-vrmc-vrm {:local/root "../org-vrmc-vrm"}
        io.github.kotoba-lang/skeleton    {:local/root "../skeleton"}}
 :aliases
 {:postprocess {:main-opts ["-m" "kami.gen.ml3d.rig"]}
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts   ["-m" "cognitect.test-runner"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
